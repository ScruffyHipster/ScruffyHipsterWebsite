{
  "name": "scruffy-hipster-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-app-content.mjs && vite",
    "generate:og": "node scripts/generate-breastfeeding-og.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .ssr-dist",
    "build": "node scripts/generate-breastfeeding-og.mjs && node scripts/generate-app-content.mjs && npm run build:client && npm run build:server && node scripts/postbuild.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@telemetrydeck/sdk": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
